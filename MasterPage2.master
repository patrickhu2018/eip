        }

        /*for 使用者切換*/
        .m0_1024_modal-content
        {
            margin: 0 200px;
        }

        .bt {
            padding: 10px 30px;
            background: #4CAF1E 0% 0% no-repeat padding-box;
            border: 0px;
            border-radius: 5px;
            opacity: 1;
            text-align: center;
            color: #FFFFFF;
            margin-right: 10px;
        }

        @media screen and (max-width: 1200px) {
            .m0_1024_modal-content
            {
                margin: 0 !important;
            }
        }
        /*for 使用者切換*/
    </style>
    <script>
        $(document).ready(function () {
            var pageContentWrapper = document.getElementById('page-content-wrapper');
            var isSidebarClosed = localStorage.getItem('isSidebarClosed');
            var trigger = $('.hamburger'),
                overlay = $('.overlay'),
                isClosed = false;

            console.log(isSidebarClosed);
            console.log($('#open'));  // 確認 #open 是否能被選中

            //if (isSidebarClosed === "true") {
            //    setTimeout(function () {
            //        $('#open').click();  // 延遲 100 毫秒
            //    }, 100);
            //} 

            trigger.click(function () {
                hamburger_cross();
            });

            function hamburger_cross() {
                if (isClosed == true) {
                    overlay.hide();
                    trigger.removeClass('is-closed');
                    trigger.addClass('is-open');
                    isClosed = false;
                    //pageContentWrapper.style.paddingLeft = '0px';
                    //pageContentWrapper.style.marginLeft = '0px';
                    //pageContentWrapper.style.width = '1660px';
                    localStorage.setItem('isSidebarClosed', 'false');
                    console.log(localStorage);
                } else {
                    overlay.show();
                    trigger.removeClass('is-open');
                    trigger.addClass('is-closed');
                    isClosed = true;
                    //pageContentWrapper.style.paddingLeft = '0px';
                    //pageContentWrapper.style.marginLeft = '80px';
                    ////pageContentWrapper.style.width = '1840px';
                    localStorage.setItem('isSidebarClosed', 'true');
                    console.log(localStorage);
                }
            }

            $('#open').click(function () {
                $('#wrapper').toggleClass('toggled');
                $('#sidebar-wrapper').toggleClass('sidebarWidth');
            });

            $("#case_setting_btn").click(function () {
                $("#case_setting_btn").addClass("setting_btn_click");
                $("#case_view_btn").removeClass("setting_btn_click");
            });

            $("#case_view_btn").click(function () {
                $("#case_view_btn").addClass("setting_btn_click");
                $("#case_setting_btn").removeClass("setting_btn_click");
            });

        });
    </script>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="AllPage" id="test" runat="server">    
    <form runat="server">
        <asp:ScriptManager runat="server"></asp:ScriptManager>
        <div class="header" id="header">
            <div class="topMenu">
                <!-- LOGO -->
                <div class="menulogo mr-md-auto ">
                    <a class="LOGO font-bold" href="#" tabindex="" runat="server" id="homepic">
                        <img src="image/long_1_R.png" alt="智慧環評監督管制雲LOGO">
                        <span style="display: none">LOGO</span>
                    </a>
                </div>
                <!-- menulogo -->
                <!-- 選單按鈕 -->
                <div class="menuBallClass ml-md-auto" style="align-items: center; z-index: 0">
                    <asp:Button runat="server" ID="change_role_btn" CssClass="bt" Text="切換使用者" style="width:auto;" OnClick="Change_role_Click"/><%--20250827 louis 新增切換使用者功能--%>
                    <asp:Label runat="server" ID="user" CssClass="user_text"></asp:Label>
                    <a runat="server" class="menuBall" id="home" title="">
                        <img src="image/bighome.png" alt="首頁"></a>
                    <a runat="server" class="menuBall" id="Instructions" title="" target="_blank" href="file/20250317_操作手冊(一般使用者)_修繕.pdf">
                        <img src="image/icon_Instructions.png" alt="操作手冊"></a>
                    <a runat="server" class="menuBall" id="video" title="" href="https://youtu.be/xmNfv0wh26E">
                        <img src="image/icon_video.png" alt="操作影片"></a>
                    <a class="menuBall" href="Login.aspx" title="">
                        <img src="image/logout.png" alt="登出"></a>
                </div>
            </div>
            <!-- topMenu -->
        </div>
        <!-- header -->
        <div id="wrapper" class="toggled">
            <div class="overlay"></div>

            <!-- Sidebar -->
            <nav class="navbar navbar-inverse fixed-top sidebarWidth" id="sidebar-wrapper" role="navigation">
                <ul class="nav sidebar-nav">
                    <div class="sidebar-header">
                        <div></div>
                        <%--class="sidebar-brand"--%>
                    </div>
                    <asp:Literal runat="server" ID="left_link"></asp:Literal>
                    <div class="sidebar-header" style="position: unset; padding: 20%; background: unset">
                        <div class="sidebar-brand" style="background: unset"></div>
                        <%----%>
                    </div>
                </ul>

            </nav>
            <!-- /#sidebar-wrapper -->
            <div id="page-content-wrapper">
                <button id="open" type="button" class="hamburger sideMenu animated fadeInLeft is-open" data-toggle="offcanvas">
                    <i class="fa fa-caret-right" aria-hidden="true" style="left: 23%; top: 39%; position: absolute;"></i>
                </button>
                <div class="whiteboard">
                    <div class="whiteHeader">
                        <div class="PageTitle">
                            <asp:Label runat="server" ID="page_title" Style="font-weight: bold">環境監測資料上傳</asp:Label><asp:Label runat="server" ID="page_title_comment" CssClass="ml-2" Style="color: #8A8A8A; font-size: 15px; display: none;"></asp:Label></>
                        </div>
                        <ul class="breadcrumb float-md-right">
                            <li><a id="home_link" runat="server" href="#"><i class="custom-icon" aria-hidden="true"></i>首頁</a></li>
                            <asp:Literal runat="server" ID="link_li" ClientIDMode="Static"></asp:Literal>
                        </ul>

                        <asp:Panel runat="server" ID="Account_btn" Style="height: 52px;" Visible="false"></asp:Panel>
                    </div>
                    <!-- whiteHeader-->

                    <div class="whiteContent" style="overflow-x: hidden;" id="mainContent">
                        <div class="container">
                            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
                        </div>
                        <!-- container-->
                    </div>
                    <!-- whiteContent-->
                </div>



                <div class="footer">
                    <span class="footer-text">最佳螢幕解析度為1920X1080</span>
                    <span class="footer-text">本網站為 中部科學園區管理局 版權所有 Copyright© 2024 由方達科技股份有限公司開發維護</span>
                </div>
            </div>


            <asp:HiddenField runat="server" ID="link_hf" Value="1" />

            <%-- 切換使用者MODAL start--%>
            <div class="modal fade" id="exampleModalCenter_role" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" style="backdrop-filter: brightness(0.3);" aria-hidden="true" data-backdrop="false">
                <div class="modal-dialog modal-dialog-centered" role="document" style="border-radius: 5px; justify-content: center; max-width: 50%;">
                    <div id="Div11" runat="server" class="modal-content m0_1024_modal-content">
                        <div class="modal-header write_Title" style="background-color: #C5ECFF; display: flex; justify-content: center;">
                            <h5 class="modal-title" runat="server" id="H2" style="font-size: 1.375rem; font-weight: bold; color: #003168;">
                                <asp:Label runat="server" ID="Label6" Text="人員切換"></asp:Label></h5>
                            <button type="button" class="close" data-dismiss="modal" style="position: absolute; right: 2%">
                                <image src="image/popup_close.png"></image>
                            </button>
                        </div>
                        <div class="modal-body" style="padding: 0">
                            <asp:UpdatePanel runat="server" ID="role_upl">
                                <ContentTemplate>
                                    <div id="Div12" runat="server" style="padding: 20px 60px;">
                                        <div style="text-align: center; font-size: 22px; font-weight: bold;">
                                            <div>
                                                <table style="width: 100%;">
                                                    <tr>
                                                        <td style="display: flex;font-size:1.375rem;">選擇人員：</td>
                                                        <td>
                                                            <asp:DropDownList ID="apply_group" runat="server" CssClass="form-control" Style="width: 100%;margin-bottom:5px;" DataSourceID="sds_group" DataTextField="name" DataValueField="id" OnSelectedIndexChanged="apply_group_SelectedIndexChanged" AutoPostBack="true"></asp:DropDownList>
                                                            <asp:SqlDataSource ID="sds_group" runat="server" SelectCommand="select '0' as id, '全部' as name union select id,name from group_name where parent_id is null" ConnectionString="<%$ ConnectionStrings:eip %>"></asp:SqlDataSource>
                                                            
                                                            <asp:DropDownList ID="ddl_division" runat="server" CssClass="form-control" Style="width: 100%;margin-bottom:5px;" DataSourceID="sds_division" DataTextField="name" DataValueField="id" OnSelectedIndexChanged="ddl_division_SelectedIndexChanged" AutoPostBack="true">
                                                                <asp:ListItem Value="0" Text="全部"></asp:ListItem>
                                                            </asp:DropDownList>
                                                            <asp:SqlDataSource ID="sds_division" runat="server" SelectCommand="" ConnectionString="<%$ ConnectionStrings:eip %>"></asp:SqlDataSource>

                                                            <asp:DropDownList ID="ddl_applicant" runat="server" CssClass="form-control" Style="width: 100%" DataSourceID="sds_applicant" DataTextField="name" DataValueField="user_id">
                                                            </asp:DropDownList>
                                                            <asp:SqlDataSource ID="sds_applicant" runat="server" SelectCommand="select '0' as user_id, '全部' as name union select user_id,name from eip_user " ConnectionString="<%$ ConnectionStrings:eip %>"></asp:SqlDataSource>
                                                            
                                                        </td>
                                                    </tr>
                                                </table>                                                                              
                                            </div>
                                        </div>
                                    </div>
                                </ContentTemplate>
                            </asp:UpdatePanel>                           
                            <div id="Div13" runat="server" class="mb-3" style="display: flex; justify-content: center;">
                                <asp:Button ID="modal_btn_cancel" runat="server" CssClass="bt" Text="取消" Style="background-color: #777777" data-dismiss="modal" aria-label="Close" />
                                <asp:Button ID="modal_btn_end" runat="server" CssClass="bt" Text="確定" OnClick="Change_role_comfirm" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <%-- 切換使用者MODAL end--%>

            <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server"></asp:ContentPlaceHolder>
        </div>

        <script type="text/javascript">

</script>

    </form>

    <style>
        /*日歷*/
        .user_text {
            background: #FFFFFF 0% 0% no-repeat padding-box;
            border-radius: 14px;
            opacity: 0.6;
            padding: 5px 20px;
            font-size: 1.1rem;
        }

        input[type="date"],
        input[type="datetime-local"],
        input[type="month"] {
            position: relative;
            background: transparent;
            cursor: not-allowed; /* 显示禁用光标 */
        }

            input[type="date"]::before,
            input[type="datetime-local"]::before,
            input[type="month"]::before {
                content: '';
                position: absolute;
                right: 0px;
                top: 50%;
                transform: translateY(-50%);
                background-image: url('image/icon_14.png'); /* 使用你上传的图片 */
                background-size: contain;
                background-repeat: no-repeat;
                width: 30px; /* 根据图片大小调整 */
                height: 30px;
                pointer-events: none; /* 禁用鼠标事件 */
            }


            input[type="date"]:disabled::-webkit-calendar-picker-indicator,
            input[type="datetime-local"]:disabled::-webkit-calendar-picker-indicator,
            input[type="month"]:disabled::-webkit-calendar-picker-indicator {
                opacity: 0; /* 隐藏默认按钮 */
                pointer-events: none; /* 禁用鼠标事件 */
            }

            input[type="date"]:enabled::-webkit-calendar-picker-indicator,
            input[type="datetime-local"]:enabled::-webkit-calendar-picker-indicator,
            input[type="month"]:enabled::-webkit-calendar-picker-indicator {
                background: none; /* 移除背景图 */
                color: transparent;
            }

            input[type="date"]:enabled,
            input[type="datetime-local"]:enabled,
            input[type="month"]:enabled {
                cursor: auto;
            }


        /*日歷*/


        .table th, .table td {
            padding: 0.2rem 0.3rem;
        }

        .form-control {
            /*  height: 35px;*/
        }


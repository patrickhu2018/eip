        .sidebar-nav li {
            border-top-left-radius: 10px; /* 左上角 */
            border-bottom-left-radius: 10px; /* 左下角 */
            align-self: center;
        }
        /*條版*/
        .form-control:disabled, .form-control[readonly] {
            background-color: #ECECEC;
        }

        .form-control {
            border: 1px solid #707070;
            color: #000000;
        }

        .custom-icon {
            position: relative;
            display: inline-block;
            width: 15px; /* 根据需要调整宽度 */
            height: 15px; /* 根据需要调整高度 */
            background-image: url('image/home.png');
            background-size: cover; /* 确保背景图片覆盖整个图标 */
            background-repeat: no-repeat; /* 禁止重复 */
            top: 10%;
        }

        .AllPage {
            background: linear-gradient(to right bottom, #DBA900 21%, #F2C222 14%);
        }


        .write_Box {
            border-radius: 15px;
        }

        .gw_bt {
            width: auto;
            height: 28px;
            background: #68B100;
            border: 1px solid transparent;
            border-radius: 5px;
            color: #ffffff;
            opacity: 1;
            margin-top: 1.5px;
            margin-bottom: 1.5px;
        }

        .grid-text {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 100%;
        }

            .grid-text:hover {
                display: block;
            }


        select {
            height: 35px !important;
        }

        .TitleFrame {
            display: flex;
            align-items: center;
        }

        .subTitleMarkText {
